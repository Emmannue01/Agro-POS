{
  "expo": {
    "name": "Agro-pos",
    "slug": "Agro-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agropos.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para escanear códigos de barras de los productos."
      }
    },
    "android": {
      "package": "com.agropos.app",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "629da153-a5bb-4d8c-85e0-7974a8372da7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/629da153-a5bb-4d8c-85e0-7974a8372da7"
    },
    "runtimeVersion": "1.0.0",
    "plugins": [
      "expo-router"
    ]
  }
}
